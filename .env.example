# ============================================================
# VELARI STUDIO SYSTEMS — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local and fill in real values
# All variables are optional for development (mocks work automatically)
# ============================================================

# ────────────────────────────────────────────────────────────
# DATABASE (Supabase)
# ────────────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ────────────────────────────────────────────────────────────
# EMAIL (Resend)
# ────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
# Server-only. Never prefix these secrets with VITE_.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FROM_EMAIL=estimates@velariss.co
# NOTIFICATION_EMAIL=info@velariss.co

# ────────────────────────────────────────────────────────────
# AI INTAKE (Anthropic)
# ────────────────────────────────────────────────────────────
# Powers the /api/intake assistant. Get from: https://console.anthropic.com
# Server-only. Never prefix these with VITE_.
# ANTHROPIC_API_KEY=sk-ant-xxxx
# Optional model override (defaults to claude-sonnet-5)
# INTAKE_MODEL=claude-sonnet-5

# ────────────────────────────────────────────────────────────
# ANALYTICS (Plausible)
# ────────────────────────────────────────────────────────────
# Register domain at: https://plausible.io
# VITE_PLAUSIBLE_DOMAIN=velariss.co

# ────────────────────────────────────────────────────────────
# NOTES
# ────────────────────────────────────────────────────────────
# - All variables prefixed with VITE_ are exposed to the browser
# - For production, move sensitive keys to edge functions
# - Mocks work automatically when variables are not set
# - See /src/lib/clients/* for integration details
